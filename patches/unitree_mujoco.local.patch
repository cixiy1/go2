+                # MuJoCo 的 accelerometer 传感器给的是「世界系、不含重力」的线
+                # 加速度；真机 imu_state.accelerometer 是「机体系、含重力的比力」
+                # —— 静止平放时读数是 (0, 0, +9.81)。两个语义差一个旋转和一个
+                # 重力项。原来直接透传，控制器在仿真里读到静止时是 0、在真机上
+                # 是 9.81，任何依赖加速度的估计（比如打滑时的测速）都没法通用。
+                # 这里按真机语义换算：先补重力得到世界系比力，再转到机体系。
+                _ax = self.mj_data.sensordata[self.dim_motor_sensor + 7]
+                _ay = self.mj_data.sensordata[self.dim_motor_sensor + 8]
+                _az = self.mj_data.sensordata[self.dim_motor_sensor + 9] + 9.81
+                _qw = self.low_state.imu_state.quaternion[0]
+                _qx = self.low_state.imu_state.quaternion[1]
+                _qy = self.low_state.imu_state.quaternion[2]
+                _qz = self.low_state.imu_state.quaternion[3]
+                # Rᵀ · f，Rᵀ 的第 i 行就是 R 的第 i 列
+                self.low_state.imu_state.accelerometer[0] = (
+                    (1 - 2 * (_qy * _qy + _qz * _qz)) * _ax
+                    + 2 * (_qx * _qy + _qw * _qz) * _ay
+                    + 2 * (_qx * _qz - _qw * _qy) * _az)
+                self.low_state.imu_state.accelerometer[1] = (
+                    2 * (_qx * _qy - _qw * _qz) * _ax
+                    + (1 - 2 * (_qx * _qx + _qz * _qz)) * _ay
+                    + 2 * (_qy * _qz + _qw * _qx) * _az)
+                self.low_state.imu_state.accelerometer[2] = (
+                    2 * (_qx * _qz + _qw * _qy) * _ax
+                    + 2 * (_qy * _qz - _qw * _qx) * _ay
+                    + (1 - 2 * (_qx * _qx + _qy * _qy)) * _az)
+
+                # 原版只填了四元数，没填 rpy，订阅方读到的 rpy 恒为 0。
+                # 姿态反馈是平衡控制的前提，这里按 ZYX 顺序从四元数换算，
