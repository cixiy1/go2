+        # 收发和电机电流环才变成力矩，编码器读数带噪声，力控还有一阶带宽。
+        # 不模拟这三样，在仿真里调好的增益一上机就抖，而且查不出为什么。
+        self.realism = bool(getattr(config, "REALISM", False))
+        if self.realism:
+            lat = float(getattr(config, "REALISM_LATENCY", 0.005))
