--- a/simulate_python/config.py
+++ b/simulate_python/config.py
@@ -1,9 +1,13 @@
 ROBOT = "go2" # Robot name, "go2", "b2", "b2w", "h1", "go2w", "g1" 
 ROBOT_SCENE = "../unitree_robots/" + ROBOT + "/scene.xml" # Robot scene
 DOMAIN_ID = 1 # Domain id
-INTERFACE = "lo" # Interface 
+# macOS: 回环接口叫 lo0，Linux 才是 lo。写 "lo" 会让 CycloneDDS 报
+# "does not match an available interface"，和之前 en5 那次是同一类错误。
+# 上真机时改成 "en5" 并把 DOMAIN_ID 改回 0。
+INTERFACE = "lo0" # Interface
 
-USE_JOYSTICK = 1 # Simulate Unitree WirelessController using a gamepad
+# 没接手柄必须设 0，否则 SetupJoystick 会抛 pygame.error 直接中断。
+USE_JOYSTICK = 0 # Simulate Unitree WirelessController using a gamepad
 JOYSTICK_TYPE = "xbox" # support "xbox" and "switch" gamepad layout
 JOYSTICK_DEVICE = 0 # Joystick number
 
@@ -12,3 +16,38 @@ ENABLE_ELASTIC_BAND = False # Virtual spring band, used for lifting h1
 
 SIMULATE_DT = 0.005  # Need to be larger than the runtime of viewer.sync()
 VIEWER_DT = 0.02  # 50 fps for viewer
+
+# ---- 真机特性开关 ----------------------------------------------------
+# 关掉它就是理想仿真：指令当帧生效、传感器无噪声。真机上跑的代码在理想仿真
+# 里调好了，一上机就抖 —— 因为真机有三样仿真默认没有的东西：力矩晚几毫秒
+# 才到、编码器读数带噪声、力控带宽有限。打开后仿真才和真机对得上，
+# 调出来的参数也才有意义。
+#
+# 每一项都能用环境变量单独关掉做对照（写调试脚本时很有用）：
+#   SIM_REALISM=0    全关，退回理想仿真
+#   SIM_LATENCY=0    只关延迟
+#   SIM_NOISE=0      只关编码器噪声
+#   SIM_BW=0         只关力控带宽
+import os
+
+
+def _envf(key, default):
+    try:
+        return float(os.environ[key])
+    except (KeyError, ValueError):
+        return default
+
+
+REALISM = _envf("SIM_REALISM", 1.0) != 0.0
+
+# 指令到力矩的总延迟（秒）。真机链路：CycloneDDS 收发 + 电机驱动电流环，
+# 实测 3~6 ms。这里按物理步长取整，5 ms 刚好一帧。
+REALISM_LATENCY = _envf("SIM_LATENCY", 0.005)
+# 编码器角度/速度噪声（1σ）。角度是 14 位绝对编码器，很小；速度是差分出来
+# 的，噪声大一个量级 —— kd 乘上去就是高频力矩噪声，真机啸叫主要来自这里。
+REALISM_Q_NOISE = _envf("SIM_Q_NOISE", 0.0015)      # rad
+REALISM_DQ_NOISE = _envf("SIM_DQ_NOISE", 0.15)      # rad/s
+# 力矩指令的跟随带宽（Hz）。Go2 电机驱动器是电流环，标称带宽 1 kHz 以上，
+# 200 Hz 的指令周期根本压不到它 —— 这里给 150 Hz 只是留一点相位滞后，
+# 不是主要瓶颈。别再往低里调：那等于把整条 PD 环降增益，腿会软得不像话。
+REALISM_TAU_BW = _envf("SIM_BW", 150.0)
diff --git a/simulate_python/headless.py b/simulate_python/headless.py
new file mode 100644
index 0000000..c679393
--- /dev/null
+++ b/simulate_python/headless.py
@@ -0,0 +1,68 @@
+"""无窗口仿真桥：与 unitree_mujoco.py 同一条物理 + DDS 链路，去掉 viewer。
+
+`unitree_mujoco.py` 里的 `launch_passive` 只负责画图，物理推进和 DDS 收发
+都在 `UnitreeSdk2Bridge` 里，跟窗口没有关系。去掉窗口之后可以在没有显示器
+的会话里跑控制器、量指标。
+
+    cd quadruped/sim/unitree_mujoco/simulate_python
+    python headless.py --seconds 60
+
+另开终端跑控制器，网卡 lo0 / domain 1，和带窗口时完全一样。
+"""
+import argparse
+import time
+
+import mujoco
+from unitree_sdk2py.core.channel import ChannelFactoryInitialize
+from unitree_sdk2py_bridge import UnitreeSdk2Bridge
+
+import config
+
+
+# 无窗口版本的主循环。
+#
+# 和原版唯一的差别是 `while viewer.is_running()` 换成了按秒数退出，另外不再
+# 持有 `locker` —— 那把锁是给 viewer 线程和物理线程互斥用的，没有 viewer
+# 就没有第二个线程碰 mj_data。
+def main() -> int:
+    ap = argparse.ArgumentParser(description="无窗口 MuJoCo 仿真桥")
+    ap.add_argument("--seconds", type=float, default=60.0, help="跑多久自动退出")
+    ap.add_argument("--no-scene-info", action="store_true",
+                    help="不打印 link/joint/actuator 清单")
+    a = ap.parse_args()
+
+    mj_model = mujoco.MjModel.from_xml_path(config.ROBOT_SCENE)
+    mj_data = mujoco.MjData(mj_model)
+    mj_model.opt.timestep = config.SIMULATE_DT
+
+    ChannelFactoryInitialize(config.DOMAIN_ID, config.INTERFACE)
+    unitree = UnitreeSdk2Bridge(mj_model, mj_data)
+    if config.USE_JOYSTICK:
+        unitree.SetupJoystick(device_id=0, js_type=config.JOYSTICK_TYPE)
+    if config.PRINT_SCENE_INFORMATION and not a.no_scene_info:
+        unitree.PrintSceneInformation()
+
+    dt = config.SIMULATE_DT
+    t0 = time.perf_counter()
+    n = 0
+    print(f"无窗口仿真就绪：dt={dt * 1000:.1f} ms，"
+          f"网卡 {config.INTERFACE} / domain {config.DOMAIN_ID}", flush=True)
+
+    while True:
+        step_start = time.perf_counter()
+        mujoco.mj_step(mj_model, mj_data)
+        n += 1
+        elapsed = time.perf_counter() - t0
+        rest = dt - (time.perf_counter() - step_start)
+        if rest > 0:
+            time.sleep(rest)
+        if elapsed >= a.seconds:
+            break
+
+    h = float(mj_data.qpos[2])
+    print(f"仿真结束：{n} 步 / {elapsed:.1f}s，末态机身高度 {h:.3f} m", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
