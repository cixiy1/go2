# 复制成 /etc/go2.env，权限 600。systemd 用 EnvironmentFile 读它，不进仓库。
#
# 这一份是控制面自己用的；VLA 子进程继承同一套环境变量。

# 真机网卡名。扩展坞上不一定是 en5 —— 用 `ip -br addr` 查哪个口在 192.168.123.x。
# 写错的表现：网页能开，点接管后 3 秒连接超时，日志里一直"没收到 rt/lowstate"。
GO2_IFACE=en5

# 网页端口。只在内网用，别做端口映射。
GO2_PORT=8080

# 页面的 token。不给就每次启动随机生成、打印在 journalctl 里。
GO2_WEB_TOKEN=

# 语言模型的 key。`llm/remote.py` 读的是 DEEPSEEK_API_KEY；
# 换厂商要同时改 `llm/model.py` 里的端点。
# DEEPSEEK_API_KEY=

# 视觉模型走本地缓存，第一次要下载权重。HF_HOME 指到大盘上，不然塞满系统盘。
# HF_HOME=/opt/models

# 掉电后 mcf 的记录文件位置，默认 /tmp，一般不用改。
# GO2_MCF_STATE=/tmp/quadruped-mcf.json
